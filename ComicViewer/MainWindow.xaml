<Window x:Class="ComicViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ComicViewer"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="ComicViewer" Height="1000" Width="700" MinHeight="400" MinWidth="520" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource SurfaceBrush}"
        ResizeMode="CanResize"
        WindowStyle="None"
        PreviewKeyDown="MainWindow_PreviewKeyDown"
        StateChanged="MainWindow_StateChanged">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40"
                            CornerRadius="0"
                            GlassFrameThickness="1"
                            ResizeBorderThickness="6" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/ReaderStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <local:PageHeightConverter x:Key="PageHeightConverter" />
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0"
                   Background="{DynamicResource TransparentBrush}"
                   LastChildFill="True">
            <Button x:Name="OpenArchiveButton"
                    DockPanel.Dock="Left"
                    MinWidth="96"
                    Margin="6"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True"
                    Style="{StaticResource ToolbarButtonStyle}"
                    Click="OpenArchiveButton_Click"
                    Content="打开压缩包" />
            <Button x:Name="CloseWindowButton"
                    DockPanel.Dock="Right"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True"
                    Style="{StaticResource CloseCaptionButtonStyle}"
                    Click="CloseWindowButton_Click"
                    Content="&#xE8BB;" />
            <Button x:Name="MaximizeRestoreWindowButton"
                    DockPanel.Dock="Right"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True"
                    Style="{StaticResource CaptionButtonStyle}"
                    Click="MaximizeRestoreWindowButton_Click"
                    Content="&#xE922;" />
            <Button x:Name="MinimizeWindowButton"
                    DockPanel.Dock="Right"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True"
                    Style="{StaticResource CaptionButtonStyle}"
                    Click="MinimizeWindowButton_Click"
                    Content="&#xE921;" />
            <StackPanel x:Name="ReadingProgressPanel"
                        DockPanel.Dock="Right"
                        Margin="8,0,6,0"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                <Border Height="28"
                        Padding="0"
                        Background="{StaticResource TransparentBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="5"
                        SnapsToDevicePixels="True">
                    <StackPanel VerticalAlignment="Center"
                                Orientation="Horizontal">
                        <TextBox x:Name="CurrentPageTextBox"
                                 shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                 Style="{StaticResource PageNumberTextBoxStyle}"
                                 IsEnabled="False"
                                 Margin="2,0"
                                 Text="0"
                                 GotKeyboardFocus="CurrentPageTextBox_GotKeyboardFocus"
                                 KeyDown="CurrentPageTextBox_KeyDown"
                                 LostKeyboardFocus="CurrentPageTextBox_LostKeyboardFocus"
                                 PreviewTextInput="CurrentPageTextBox_PreviewTextInput" />
                        <Border Width="1"
                                Height="16"
                                VerticalAlignment="Center"
                                Background="{StaticResource BorderBrush}" />
                        <TextBlock x:Name="TotalPagesTextBlock"
                                   Margin="8,0"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   Text="0" />
                    </StackPanel>
                </Border>
                <Border Height="28"
                        MinWidth="50"
                        Margin="6,0,0,0"
                        Padding="8,0"
                        Background="{StaticResource TransparentBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="5"
                        SnapsToDevicePixels="True">
                    <TextBlock x:Name="LoadedRangeTextBlock"
                               VerticalAlignment="Center"
                               TextAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextMutedBrush}"
                               Text="未载入" />
                </Border>
            </StackPanel>
            <TextBlock x:Name="StatusTextBlock"
                       Margin="0,0,6,0"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource TextMutedBrush}"
                       TextTrimming="CharacterEllipsis"
                       Text="请选择 zip 或 rar 漫画压缩包" />
        </DockPanel>

        <ListBox x:Name="PagesListBox"
                 Grid.Row="1"
                 PreviewMouseWheel="ImageScrollViewer_PreviewMouseWheel"
                 ScrollViewer.ScrollChanged="ImageScrollViewer_ScrollChanged"
                 SizeChanged="ImageScrollViewer_SizeChanged"
                 Style="{StaticResource ComicPagesListBoxStyle}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Width="{Binding PageWidth, RelativeSource={RelativeSource AncestorType={x:Type local:MainWindow}}}"
                          Style="{StaticResource PageContainerGridStyle}">
                        <Grid.Height>
                            <MultiBinding Converter="{StaticResource PageHeightConverter}">
                                <Binding Path="AspectRatio" />
                                <Binding Path="PageWidth" RelativeSource="{RelativeSource AncestorType={x:Type local:MainWindow}}" />
                            </MultiBinding>
                        </Grid.Height>
                        <Image Source="{Binding DisplayImage}"
                               HorizontalAlignment="Stretch"
                               VerticalAlignment="Stretch"
                               Stretch="Fill" />

                        <Grid Background="{DynamicResource TransparentBrush}"
                              MouseLeftButtonDown="VideoSurface_MouseLeftButtonDown"
                              Style="{StaticResource VideoSurfaceVisibilityStyle}">

                            <ContentControl
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Stretch"
                                            IsHitTestVisible="False"
                                            Panel.ZIndex="0"
                                            Content="{Binding PlaybackElement}"
                                            Style="{StaticResource VideoPlaybackHostVisibilityStyle}" />

                            <Button HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    CommandParameter="{Binding}"
                                    Panel.ZIndex="2"
                                    Style="{StaticResource PlayOverlayButtonStyle}"
                                    Click="PlayVideoButton_Click" />
                        </Grid>

                        <StackPanel HorizontalAlignment="Left"
                                    VerticalAlignment="Bottom"
                                    Margin="8"
                                    Orientation="Horizontal"
                                    IsHitTestVisible="False">
                            <Border Style="{StaticResource OverlayBadgeBorderStyle}">
                                <TextBlock Style="{StaticResource BadgeTextBlockStyle}"
                                           Text="{Binding DisplayNumber}" />
                            </Border>
                            <Border Style="{StaticResource VideoBadgeBorderStyle}">
                                <TextBlock Style="{StaticResource BadgeTextBlockStyle}"
                                           Text="{Binding VideoOverlayText}" />
                            </Border>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <ContentControl x:Name="PlayerParkingHost"
                        Grid.Row="1"
                        Width="480"
                        Height="270"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        IsHitTestVisible="False"
                        Opacity="0"
                        Panel.ZIndex="-1" />

        <Grid x:Name="PasswordOverlay"
              Grid.Row="1"
              Background="{StaticResource TransparentBrush}"
              Visibility="Collapsed">
            <Border Style="{StaticResource PasswordPanelBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="PasswordPromptTextBlock"
                               Grid.Row="0"
                               Text="输入压缩包密码"
                               Margin="0,0,0,6"
                               FontSize="18"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               Style="{StaticResource PrimaryTextBlockStyle}" />

                    <TextBlock x:Name="PasswordArchiveNameTextBlock"
                               Grid.Row="1"
                               Margin="0,6,0,0"
                               TextTrimming="CharacterEllipsis"
                               Style="{StaticResource MutedTextBlockStyle}" />

                    <PasswordBox x:Name="ArchivePasswordBox"
                                 Grid.Row="2"
                                 Margin="0,10,0,0"
                                 Style="{StaticResource PasswordBoxStyle}"
                                 KeyDown="ArchivePasswordBox_KeyDown"
                                 PasswordChanged="ArchivePasswordBox_PasswordChanged"/>

                    <StackPanel Grid.Row="3"
                                Margin="0,10,0,0"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right">
                        <Button MinWidth="82"
                                Margin="0,0,10,0"
                                Style="{StaticResource ToolbarButtonStyle}"
                                Click="PasswordCancelButton_Click"
                                Content="取消" />
                        <Button x:Name="PasswordOpenButton"
                                MinWidth="82"
                                Style="{StaticResource ToolbarButtonStyle}"
                                Click="PasswordOpenButton_Click"
                                IsEnabled="False"
                                Content="打开" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
