<Window x:Class="ComicViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ComicViewer"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="ComicViewer" Height="1000" Width="700" MinHeight="400" MinWidth="280" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackgroundBrush}"
        ResizeMode="CanResize"
        WindowStyle="None"
        PreviewKeyDown="MainWindow_PreviewKeyDown"
        StateChanged="MainWindow_StateChanged">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40"
                            CornerRadius="0"
                            GlassFrameThickness="1"
                            ResizeBorderThickness="6" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <SolidColorBrush x:Key="AppBackgroundBrush" Color="#111111" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#202020" />
        <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#303030" />
        <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#3C3C3C" />
        <SolidColorBrush x:Key="OverlayBrush" Color="#99000000" />
        <SolidColorBrush x:Key="OverlayHoverBrush" Color="#B0000000" />
        <SolidColorBrush x:Key="OverlayPressedBrush" Color="#CC000000" />
        <SolidColorBrush x:Key="OverlayBorderBrush" Color="#88FFFFFF" />
        <SolidColorBrush x:Key="OverlayBorderStrongBrush" Color="#CCFFFFFF" />
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F2F2F2" />
        <SolidColorBrush x:Key="TextMutedBrush" Color="#BDBDBD" />
        <SolidColorBrush x:Key="BorderBrush" Color="#555555" />
        <SolidColorBrush x:Key="DangerBrush" Color="#C42B1C" />
        <SolidColorBrush x:Key="DangerPressedBrush" Color="#A4261D" />

        <Style x:Key="PrimaryTextBlockStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        </Style>

        <Style x:Key="MutedTextBlockStyle"
               TargetType="{x:Type TextBlock}"
               BasedOn="{StaticResource PrimaryTextBlockStyle}">
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
        </Style>

        <Style x:Key="BadgeTextBlockStyle"
               TargetType="{x:Type TextBlock}"
               BasedOn="{StaticResource PrimaryTextBlockStyle}">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="OverlayBadgeBorderStyle" TargetType="{x:Type Border}">
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="Background" Value="{StaticResource OverlayBrush}" />
            <Setter Property="CornerRadius" Value="3" />
        </Style>

        <Style x:Key="PageContainerGridStyle" TargetType="{x:Type Grid}">
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Background" Value="{StaticResource AppBackgroundBrush}" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="UseLayoutRounding" Value="True" />
        </Style>

        <Style x:Key="ImagePageVisibilityStyle" TargetType="{x:Type Image}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsImage}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="VideoSurfaceVisibilityStyle" TargetType="{x:Type Grid}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsVideo}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="VideoFrameVisibilityStyle" TargetType="{x:Type Image}">
            <Setter Property="Visibility" Value="Visible" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding VideoFrame}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="VideoBadgeBorderStyle"
               TargetType="{x:Type Border}"
               BasedOn="{StaticResource OverlayBadgeBorderStyle}">
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsVideo}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PasswordPanelBorderStyle" TargetType="{x:Type Border}">
            <Setter Property="Width" Value="420" />
            <Setter Property="MaxWidth" Value="520" />
            <Setter Property="Padding" Value="10" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>

        <Style x:Key="PasswordBoxStyle" TargetType="{x:Type PasswordBox}">
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="2,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="{StaticResource AppBackgroundBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type PasswordBox}">
                        <Border x:Name="PasswordBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="PasswordBorder" Property="BorderBrush" Value="{StaticResource OverlayBorderStrongBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="PasswordBorder" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToolbarButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Height" Value="28" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource SurfaceBrush}" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CaptionButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Cursor" Value="Arrow" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseCaptionButtonStyle"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource CaptionButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource DangerBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource DangerPressedBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PlayOverlayButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="100" />
            <Setter Property="Height" Value="100" />
            <Setter Property="Background" Value="{StaticResource OverlayBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource OverlayBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontFamily" Value="Segoe UI Emoji" />
            <Setter Property="FontSize" Value="36" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Visibility" Value="Visible" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonBorder"
                                Width="{TemplateBinding Width}"
                                Height="{TemplateBinding Height}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="50"
                                SnapsToDevicePixels="True">
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Padding="5,-5,0,0"
                                       FontFamily="{TemplateBinding FontFamily}"
                                       FontSize="48"
                                       Foreground="{TemplateBinding Foreground}"
                                       Text="▷" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource OverlayHoverBrush}" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource OverlayBorderStrongBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource OverlayPressedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsVideoPlaying}" Value="True" />
                        <Condition Binding="{Binding IsVideoPaused}" Value="False" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Visibility" Value="Collapsed" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="InvisibleScrollBarButtonStyle" TargetType="{x:Type RepeatButton}">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RepeatButton}">
                        <Border Background="{TemplateBinding Background}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ComicScrollBarThumbStyle" TargetType="{x:Type Thumb}">
            <Setter Property="Background" Value="{StaticResource OverlayBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource OverlayBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border x:Name="ThumbBorder"
                                Margin="2"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                SnapsToDevicePixels="True" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbBorder" Property="Background" Value="{StaticResource OverlayHoverBrush}" />
                                <Setter TargetName="ThumbBorder" Property="BorderBrush" Value="{StaticResource OverlayBorderStrongBrush}" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbBorder" Property="Background" Value="{StaticResource OverlayPressedBrush}" />
                                <Setter TargetName="ThumbBorder" Property="BorderBrush" Value="{StaticResource OverlayBorderStrongBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ComicScrollBarStyle" TargetType="{x:Type ScrollBar}">
            <Setter Property="Width" Value="14" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid Width="{TemplateBinding Width}"
                              Background="Transparent">
                            <local:MinimumThumbTrack x:Name="PART_Track"
                                                     IsDirectionReversed="True"
                                                     MinimumThumbLength="40">
                                <local:MinimumThumbTrack.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}"
                                                  CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                                  Style="{StaticResource InvisibleScrollBarButtonStyle}" />
                                </local:MinimumThumbTrack.DecreaseRepeatButton>
                                <local:MinimumThumbTrack.Thumb>
                                    <Thumb Style="{StaticResource ComicScrollBarThumbStyle}" />
                                </local:MinimumThumbTrack.Thumb>
                                <local:MinimumThumbTrack.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}"
                                                  CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                                  Style="{StaticResource InvisibleScrollBarButtonStyle}" />
                                </local:MinimumThumbTrack.IncreaseRepeatButton>
                            </local:MinimumThumbTrack>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ComicScrollViewerStyle" TargetType="{x:Type ScrollViewer}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollViewer}">
                        <Grid Background="{TemplateBinding Background}"
                              ClipToBounds="True">
                            <ScrollContentPresenter x:Name="PART_ScrollContentPresenter"
                                                    CanContentScroll="{TemplateBinding CanContentScroll}"
                                                    Content="{TemplateBinding Content}"
                                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                                    ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                                    Margin="{TemplateBinding Padding}" />
                            <ScrollBar x:Name="PART_VerticalScrollBar"
                                       Panel.ZIndex="1"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Stretch"
                                       Margin="0,4,2,4"
                                       Maximum="{TemplateBinding ScrollableHeight}"
                                       Orientation="Vertical"
                                       Style="{StaticResource ComicScrollBarStyle}"
                                       Value="{Binding VerticalOffset, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}"
                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" />
                            <ScrollBar x:Name="PART_HorizontalScrollBar"
                                       Visibility="Collapsed" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ComicPageListBoxItemStyle" TargetType="{x:Type ListBoxItem}">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ComicPagesListBoxStyle" TargetType="{x:Type ListBox}">
            <Setter Property="Background" Value="{StaticResource AppBackgroundBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
            <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel" />
            <Setter Property="VirtualizingPanel.CacheLength" Value="2" />
            <Setter Property="VirtualizingPanel.CacheLengthUnit" Value="Page" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource ComicPageListBoxItemStyle}" />
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel Orientation="Vertical" />
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBox}">
                        <ScrollViewer x:Name="PART_ScrollViewer"
                                      Background="{TemplateBinding Background}"
                                      CanContentScroll="{TemplateBinding ScrollViewer.CanContentScroll}"
                                      HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                                      Padding="{TemplateBinding Padding}"
                                      Style="{StaticResource ComicScrollViewerStyle}"
                                      VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}">
                            <ItemsPresenter />
                        </ScrollViewer>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0"
                   Background="{StaticResource SurfaceBrush}"
                   LastChildFill="True">
            <Button x:Name="OpenArchiveButton"
                    DockPanel.Dock="Left"
                    MinWidth="96"
                    Margin="6"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True"
                    Style="{StaticResource ToolbarButtonStyle}"
                    Click="OpenArchiveButton_Click"
                    Content="打开压缩包" />
            <Button x:Name="CloseWindowButton"
                    DockPanel.Dock="Right"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True"
                    Style="{StaticResource CloseCaptionButtonStyle}"
                    Click="CloseWindowButton_Click"
                    Content="&#xE8BB;" />
            <Button x:Name="MaximizeRestoreWindowButton"
                    DockPanel.Dock="Right"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True"
                    Style="{StaticResource CaptionButtonStyle}"
                    Click="MaximizeRestoreWindowButton_Click"
                    Content="&#xE922;" />
            <Button x:Name="MinimizeWindowButton"
                    DockPanel.Dock="Right"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True"
                    Style="{StaticResource CaptionButtonStyle}"
                    Click="MinimizeWindowButton_Click"
                    Content="&#xE921;" />
            <TextBlock x:Name="StatusTextBlock"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource TextMutedBrush}"
                       TextTrimming="CharacterEllipsis"
                       Text="请选择 zip 或 rar 漫画压缩包" />
        </DockPanel>

        <ListBox x:Name="PagesListBox"
                 Grid.Row="1"
                 ItemsSource="{Binding Pages}"
                 PreviewMouseWheel="ImageScrollViewer_PreviewMouseWheel"
                 ScrollViewer.ScrollChanged="ImageScrollViewer_ScrollChanged"
                 SizeChanged="ImageScrollViewer_SizeChanged"
                 Style="{StaticResource ComicPagesListBoxStyle}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Width="{Binding DisplayWidth}"
                          Height="{Binding DisplayHeight}"
                          Style="{StaticResource PageContainerGridStyle}">
                        <Image Source="{Binding Image}"
                               Stretch="Fill"
                               Style="{StaticResource ImagePageVisibilityStyle}" />

                        <Grid Background="Transparent"
                              MouseLeftButtonDown="VideoSurface_MouseLeftButtonDown"
                              Style="{StaticResource VideoSurfaceVisibilityStyle}">

                            <Image Source="{Binding VideoFrame}"
                                   Stretch="Uniform"
                                   IsHitTestVisible="False"
                                   Style="{StaticResource VideoFrameVisibilityStyle}" />

                            <Button HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    CommandParameter="{Binding}"
                                    Style="{StaticResource PlayOverlayButtonStyle}"
                                    Click="PlayVideoButton_Click" />
                        </Grid>

                        <StackPanel HorizontalAlignment="Left"
                                    VerticalAlignment="Bottom"
                                    Margin="8"
                                    Orientation="Horizontal"
                                    IsHitTestVisible="False">
                            <Border Style="{StaticResource OverlayBadgeBorderStyle}">
                                <TextBlock Style="{StaticResource BadgeTextBlockStyle}"
                                           Text="{Binding DisplayNumber}" />
                            </Border>
                            <Border Style="{StaticResource VideoBadgeBorderStyle}">
                                <TextBlock Style="{StaticResource BadgeTextBlockStyle}"
                                           Text="{Binding VideoOverlayText}" />
                            </Border>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Grid x:Name="PasswordOverlay"
              Grid.Row="1"
              Background="{StaticResource OverlayPressedBrush}"
              Visibility="Collapsed">
            <Border Style="{StaticResource PasswordPanelBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="PasswordPromptTextBlock"
                               Grid.Row="0"
                               Text="输入压缩包密码"
                               FontSize="18"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               Style="{StaticResource PrimaryTextBlockStyle}" />

                    <TextBlock x:Name="PasswordArchiveNameTextBlock"
                               Grid.Row="1"
                               Margin="0,6,0,0"
                               TextTrimming="CharacterEllipsis"
                               Style="{StaticResource MutedTextBlockStyle}" />

                    <PasswordBox x:Name="ArchivePasswordBox"
                                 Grid.Row="2"
                                 Margin="0,10,0,0"
                                 Style="{StaticResource PasswordBoxStyle}"
                                 KeyDown="ArchivePasswordBox_KeyDown"
                                 PasswordChanged="ArchivePasswordBox_PasswordChanged"/>

                    <StackPanel Grid.Row="3"
                                Margin="0,10,0,0"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right">
                        <Button MinWidth="82"
                                Margin="0,0,10,0"
                                Style="{StaticResource ToolbarButtonStyle}"
                                Click="PasswordCancelButton_Click"
                                Content="取消" />
                        <Button x:Name="PasswordOpenButton"
                                MinWidth="82"
                                Style="{StaticResource ToolbarButtonStyle}"
                                Click="PasswordOpenButton_Click"
                                IsEnabled="False"
                                Content="打开" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
